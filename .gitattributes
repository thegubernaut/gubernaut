# Normalise line endings so a Windows checkout does not rewrite every file.
* text=auto eol=lf

# Binary and generated
*.wasm    binary
*.png     binary
*.svg     text eol=lf
*.crate   binary

# The golden corpus is compared byte for byte between two languages.
# A line-ending rewrite would break the parity test in a way that looks
# like a controller regression.
packages/rust/tests/golden/traces.jsonl -text

# Raw measured outputs. Published unedited; never normalised.
receipts/**/*.jsonl  -text
receipts/**/*.csv    -text

# Keep lockfiles out of diffs and language stats.
package-lock.json  linguist-generated=true
Cargo.lock         linguist-generated=true
