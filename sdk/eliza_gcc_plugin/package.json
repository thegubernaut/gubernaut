{
  "name": "@gubernaut/plugin-gcc",
  "version": "1.0.0",
  "description": "ElizaOS plugin: route agent LLM calls through the Gubernaut Cognitive Controller (GCC) local proxy — deterministic homeostatic governance, runaway-loop hard-stop, and cost containment.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/gcc-provider.test.ts test/plugin-keys.test.ts",
    "build": "tsup",
    "prepack": "npm run build"
  },
  "keywords": [
    "elizaos",
    "plugin",
    "gubernaut",
    "gcc",
    "governance",
    "ai-agents",
    "web3"
  ],
  "author": "Gubernaut Research",
  "license": "Apache-2.0",
  "homepage": "https://gubernaut.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegubernaut/gubernaut.git",
    "directory": "sdk/eliza_gcc_plugin"
  },
  "bugs": {
    "url": "https://github.com/thegubernaut/gubernaut/issues"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
